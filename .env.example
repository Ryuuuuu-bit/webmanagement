# PostgreSQL connection string
# Local dev example (Docker): postgresql://postgres:postgres@localhost:5432/webmanagement
DATABASE_URL="postgresql://user:password@localhost:5432/webmanagement"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Gmail SMTP — used to email the account-verification link on self-registration.
# 1. Turn on 2-Step Verification on this Gmail account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
#    (a normal Gmail login password will NOT work here)
GMAIL_USER="your-gmail-account@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_FROM="your-gmail-account@gmail.com"
