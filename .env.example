# PostgreSQL connection string
# Local dev example (Docker): postgresql://postgres:postgres@localhost:5432/webmanagement
DATABASE_URL="postgresql://user:password@localhost:5432/webmanagement"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# API key for place-name search on the check-in locations admin page
# (src/lib/geocode.ts), from a Google Cloud project with billing enabled and
# "Places API (New)" turned on: https://console.cloud.google.com/
# At this app's low usage this should stay within Google's free monthly
# quota for Text Search, but (unlike the free OSM-based options tried
# earlier) it does require a billing account/card on file with Google.
GOOGLE_PLACES_API_KEY="change-me"

