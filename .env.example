# PostgreSQL connection string
# Local dev example (Docker): postgresql://postgres:postgres@localhost:5432/webmanagement
DATABASE_URL="postgresql://user:password@localhost:5432/webmanagement"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Free API key for place-name search on the check-in locations admin page
# (src/lib/geocode.ts). Sign up (no credit card needed) at
# https://www.geoapify.com/ — free tier: 3,000 lookups/day.
GEOAPIFY_API_KEY="change-me"

