# PostgreSQL connection string
# Local dev example (Docker): postgresql://postgres:postgres@localhost:5432/webmanagement
DATABASE_URL="postgresql://user:password@localhost:5432/webmanagement"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# API key for place-name search on the check-in locations admin page
# (src/lib/geocode.ts), from a Google Cloud project with billing enabled and
# "Places API (New)" turned on: https://console.cloud.google.com/
# At this app's low usage this should stay within Google's free monthly
# quota for Text Search, but (unlike the free OSM-based options tried
# earlier) it does require a billing account/card on file with Google.
GOOGLE_PLACES_API_KEY="change-me"

# Server timezone — all day/time logic in the app assumes Thailand local time.
TZ="Asia/Bangkok"

# Optional: lets Admin email a "set your password" link (Resend, https://resend.com).
# Leave empty and the button simply doesn't appear; everything else works.
RESEND_API_KEY=""
EMAIL_FROM="TeachSchedule <no-reply@example.com>"

# One-off maintenance hooks run by `npm start` (scripts/*.mjs). Each is a
# single-use token recorded in AppSetting — set a NEW value to run once,
# then clear it. Leave empty in normal operation.
SEED_DEMO_USERS=""        # any new token: wipe all MEMBER accounts and seed 3 demo teachers
DELETE_USERS=""           # comma-separated usernames to delete (needs MAINTENANCE_TOKEN)
MAINTENANCE_TOKEN=""

# Web Push (notifications while the PWA is closed). Generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave empty and the "phone notifications" switch simply doesn't appear.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# One-off password reset for a locked-out account (e.g. the only Admin):
# RESET_PASSWORD_USER = username, RESET_PASSWORD_VALUE = new temporary password
# (≥8 chars), MAINTENANCE_TOKEN = any new value. Applied once on next start,
# then clear the variables.
# RESET_PASSWORD_USER=
# RESET_PASSWORD_VALUE=
