# PostgreSQL connection string
# Local dev example (Docker): postgresql://postgres:postgres@localhost:5432/webmanagement
DATABASE_URL="postgresql://user:password@localhost:5432/webmanagement"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Brevo transactional email API — used to email the account-verification link
# on self-registration. Sent over HTTPS (port 443), not SMTP, because most
# cloud hosts (including Railway) block outbound SMTP ports (587/465).
# 1. Create a free account: https://www.brevo.com (free tier: 300 emails/day)
# 2. Verify a sender email: Senders, Domains & Dedicated IPs > Senders > Add a sender
#    (no custom domain needed — a normal Gmail address works fine as the sender)
# 3. Create an API key: SMTP & API > API Keys > Generate a new API key
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="your-verified-sender@gmail.com"
