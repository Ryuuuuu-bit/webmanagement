generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

// Statutory leave categories under the Thai Labor Protection Act (พ.ร.บ. คุ้มครองแรงงาน):
// SICK/PERSONAL/VACATION were already supported; MATERNITY (ม.41), STERILIZATION (ม.33),
// MILITARY service leave (ม.35), and TRAINING leave (ม.36) are the remaining categories the
// law requires employers to allow. (A 2025 amendment reportedly adds paid spousal leave and
// child sick-care leave — deliberately not added here pending confirmation against a primary
// legal source; see conversation with Admin.)
enum LeaveType {
  SICK
  PERSONAL
  VACATION
  MATERNITY
  STERILIZATION
  MILITARY
  TRAINING
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PENDING
  ON_TIME
  LATE
  ABSENT
  LEAVE
}

enum AttestType {
  FORGOT_CHECKIN
  FORGOT_CHECKOUT
  FORGOT_BOTH
}

enum LessonPlanStatus {
  PENDING
  APPROVED
  NEEDS_REVISION
}

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]
}

model User {
  id            String    @id @default(cuid())
  name          String
  // Sign-in name (client request: teachers log in with a username, not
  // their email). Admin sets it when creating the account; the login page
  // also accepts the email. Stored lowercase. Nullable only so existing
  // rows can be backfilled from the email's local part on first deploy
  // (scripts/backfill-usernames.mjs, run from the start script).
  username      String?   @unique
  // Kept as the recovery channel: "forgot password" emails go here.
  email         String    @unique
  passwordHash  String
  role          Role      @default(MEMBER)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  // The one site this teacher is permanently stationed at (client concept:
  // "ประจำ" — the system now spans many organizations'/campuses' sites, each
  // teacher assigned to exactly one). This is the sole source of truth for
  // check-in/out validation (see getExpectedSite in src/lib/geo.ts) — it
  // replaced the earlier per-day, schedule/room-derived site lookup, which
  // required full course/room data entry and didn't fit a teacher simply
  // stationed at one site. Nullable so existing/new teachers keep working
  // (check-in/out blocked with a clear message) until Admin assigns one.
  campusLocationId String?
  campusLocation   CampusLocation? @relation(fields: [campusLocationId], references: [id])
  // Admin-created accounts (no self-registration): true right after an admin
  // creates or resets the account, until the user sets their own password.
  mustChangePassword Boolean @default(false)
  // Bumped on password reset/change or role change so existing JWT sessions
  // (which otherwise keep working until they expire) are forced to log in
  // again and pick up the change immediately.
  tokenVersion  Int       @default(0)
  // Admin can suspend an account (teacher left, on long leave) instead of
  // deleting it — keeps their attendance/leave history intact while
  // blocking login immediately (checked at sign-in and on every request via
  // the jwt callback, alongside tokenVersion).
  isActive      Boolean   @default(true)
  // A temporary password (admin created/reset the account) is only good for
  // a limited time — after this the person must ask Admin for a new one or
  // use an enrollment link instead. null once they've set their own password.
  tempPasswordExpiresAt DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())

  schedules          Schedule[]
  attendances        Attendance[]
  leaveRequests      LeaveRequest[]       @relation("LeaveRequester")
  decidedLeaves      LeaveRequest[]       @relation("LeaveApprover")
  attestRequests     TimeAttestation[]    @relation("AttestRequester")
  decidedAttests     TimeAttestation[]    @relation("AttestApprover")
  lessonPlans        LessonPlan[]         @relation("LessonPlanTeacher")
  reviewedLessonPlans LessonPlan[]        @relation("LessonPlanReviewer")
  webauthnCredentials WebauthnCredential[]
  enrollmentTokens    EnrollmentToken[]
  loginTickets        LoginTicket[]
  passwordResetTokens PasswordResetToken[]
}

// "Forgot password" / "set your password" email link. Single-use,
// hash-only storage; 30 minutes for a self-service reset, 7 days when
// Admin sends a new account its setup link. Redeeming it sets a new
// password and bumps tokenVersion (kicks every other session).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String // "reset" | "setup"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Brute-force protection state, persisted so it survives container
// restarts/redeploys (the earlier in-memory Map reset on every deploy) and
// keyed by email+IP / IP rather than email alone, so a stranger hammering a
// teacher's email from elsewhere can't lock that teacher out of their own
// phone. Rows are upserted per failed attempt and cleared on success; a
// row past its window is simply treated as fresh. See src/lib/security.ts.
model LoginLock {
  key         String    @id // "e:<email>|<ip>" or "ip:<ip>"
  count       Int       @default(0)
  firstFailAt DateTime  @default(now())
  lockedUntil DateTime?
}

// One-time, short-lived (60s) sign-in ticket: the bridge between a
// server-verified passkey assertion or a redeemed enrollment link and an
// actual NextAuth session. The client hands the ticket to the "ticket"
// credentials provider in src/lib/auth.ts, which consumes it (deletes the
// row) and signs the user in. Only the SHA-256 hash of the ticket is stored.
model LoginTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  purpose   String // "passkey" | "enrollment"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Admin-issued "link this device" QR/URL for a teacher: scanning it on
// their phone signs them in without ever typing a password and walks them
// through registering that phone's Face ID/fingerprint as a passkey.
// Single-use, expires after 7 days, hash-only storage — the raw token only
// ever exists in the QR the admin shows the teacher.
model EnrollmentToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// Security audit trail: who signed in (or failed to), from where, and every
// account-affecting admin action — so an attendance dispute ("that wasn't
// me checking in") or a suspicious pattern can be investigated. Append-only;
// never deleted by the app. See src/lib/audit.ts for the action names.
model AuditLog {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  action       String
  actorId      String? // who did it (null for anonymous/failed logins)
  targetUserId String? // whose account it concerns
  ip           String?
  detail       String?

  @@index([at])
  @@index([targetUserId])
}

model Course {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  schedules   Schedule[]
  lessonPlans LessonPlan[]
}

model Room {
  id        String     @id @default(cuid())
  name      String
  building  String
  // Which registered check-in geofence this room's classes happen at.
  // Nullable so existing rooms keep working after this column is added —
  // Admin assigns a site per room in Master Data. A room with no site set
  // blocks check-in/out for any teacher whose schedule points at it (see
  // getExpectedSite in src/lib/geo.ts), with a message telling them to
  // contact the admin, rather than silently allowing check-in from anywhere.
  campusLocationId String?
  campusLocation   CampusLocation? @relation(fields: [campusLocationId], references: [id])
  schedules Schedule[]
}

model Semester {
  id        String     @id @default(cuid())
  name      String // e.g. "1/2569"
  startDate DateTime
  endDate   DateTime
  schedules Schedule[]
}

// FR-17: configurable check-in/out geofence locations (not hardcoded)
model CampusLocation {
  id           String @id @default(cuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int    @default(150)
  rooms        Room[]
  // Teachers permanently stationed at this site (see User.campusLocationId).
  teachers     User[]
}

model Schedule {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    User     @relation(fields: [teacherId], references: [id])
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])
  dayOfWeek  Int // 0=Mon .. 6=Sun (Sat/Sun for extra/make-up classes)
  // Free-form time (like a real calendar, not fixed period slots) — a
  // teacher's class can start/end at any time, e.g. "09:15"-"10:05".
  startTime  String // "HH:MM"
  endTime    String // "HH:MM"
  note       String? // free-text detail about this class session
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([teacherId])
  @@index([semesterId])
}

// FR-4: check-in / check-out by location
model Attendance {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id])
  date   DateTime // stored at local midnight — one row per user per day

  checkinAt  DateTime?
  checkinLat Float?
  checkinLng Float?

  checkoutAt  DateTime?
  checkoutLat Float?
  checkoutLng Float?

  status AttendanceStatus @default(PENDING)

  // FR-13: attested (manually confirmed) time is recorded distinctly from a real GPS check
  attestedCheckin  Boolean @default(false)
  attestedCheckout Boolean @default(false)

  @@unique([userId, date])
  @@index([date])
}

// FR-5 / FR-8: leave request + approval workflow
model LeaveRequest {
  id          String        @id @default(cuid())
  requesterId String
  requester   User          @relation("LeaveRequester", fields: [requesterId], references: [id])
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  reason      String
  status      RequestStatus @default(PENDING)
  approverId  String?
  approver    User?         @relation("LeaveApprover", fields: [approverId], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())
}

// Annual leave quota per leave type (in days), editable by Admin in Master
// Data. Applies uniformly to every employee (not per-person) — the client
// wanted one shared number per type, not individual overrides. Resets every
// calendar year (Jan 1 – Dec 31), so "used" is computed from LeaveRequest
// rows filtered to the current year rather than stored here. Not blocking:
// a request over quota still goes through, just flagged as a warning to the
// requester and the approving Admin (src/lib/leaveQuota.ts). 0 means
// "unlimited" — no day cap enforced/shown for that type. A row missing here
// falls back to the statutory-minimum defaults in src/lib/leaveQuota.ts
// until Admin sets an explicit value.
model LeaveQuota {
  type        LeaveType @id
  daysPerYear Int
  updatedAt   DateTime  @updatedAt
}

// FR-13: time attestation request + approval workflow
model TimeAttestation {
  id            String        @id @default(cuid())
  requesterId   String
  requester     User          @relation("AttestRequester", fields: [requesterId], references: [id])
  date          DateTime
  type          AttestType
  requestedTime String // "08:25" — check-in time (or the single time, for a one-sided request)
  requestedCheckoutTime String? // set only when type=FORGOT_BOTH — the check-out time
  reason        String
  status        RequestStatus @default(PENDING)
  approverId    String?
  approver      User?         @relation("AttestApprover", fields: [approverId], references: [id])
  decidedAt     DateTime?
  createdAt     DateTime      @default(now())
}

// FR-6: lesson plan submission — teacher uploads a file per course they
// teach, Admin reviews it and either approves or sends it back with a note
// for revision (one record per teacher+course, overwritten on resubmission).
model LessonPlan {
  id          String           @id @default(cuid())
  teacherId   String
  teacher     User             @relation("LessonPlanTeacher", fields: [teacherId], references: [id])
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id])
  fileName    String
  fileData    Bytes
  mimeType    String
  fileSize    Int
  status      LessonPlanStatus @default(PENDING)
  reviewerId  String?
  reviewer    User?            @relation("LessonPlanReviewer", fields: [reviewerId], references: [id])
  reviewNote  String?
  submittedAt DateTime         @default(now())
  decidedAt   DateTime?

  @@unique([teacherId, courseId])
}

// Anti "buddy punching" (ฝากเช็คอิน/เช็คเอาต์แทนกัน): each teacher can
// register their own device's fingerprint/Face ID (via the WebAuthn
// "platform authenticator") as a passkey tied to their account. Check-in
// and check-out (src/actions/attendance.ts) require a fresh WebAuthn
// assertion — or, as a fallback for a device that doesn't support platform
// biometrics, the account password — proving the person physically present
// with the phone is the account owner, not just someone who is logged in
// on it. A teacher can register more than one device (e.g. phone + backup).
model WebauthnCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Base64url credential ID from the authenticator — how we look up which
  // stored credential a given assertion claims to be from.
  credentialId String    @unique
  publicKey    Bytes
  // Signature counter reported by the authenticator; bumped on every
  // successful use and checked to detect a cloned/replayed credential.
  counter      Int       @default(0)
  deviceType   String // "singleDevice" | "multiDevice" (per @simplewebauthn)
  backedUp     Boolean   @default(false)
  transports   String? // comma-separated (e.g. "internal,hybrid")
  // Optional teacher-chosen label so they can tell devices apart in the
  // "manage devices" list (e.g. "มือถือเครื่องหลัก").
  label        String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}

// Short-lived WebAuthn challenge, issued when starting a registration or
// verification ceremony and consumed (deleted) the moment it's checked —
// so each challenge can only ever be used once, and a stale one can't be
// replayed. One row per user at a time is enough since a person can only
// be completing one such prompt at once.
model WebauthnChallenge {
  id        String   @id @default(cuid())
  userId    String
  challenge String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
}
